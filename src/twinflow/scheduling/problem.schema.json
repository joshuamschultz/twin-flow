{
  "$defs": {
    "AbsDiffTerm": {
      "additionalProperties": false,
      "description": "Setup term: `seconds_per_unit * |a - b|` over a numeric setup parameter (D-064).",
      "properties": {
        "kind": {
          "const": "abs_diff",
          "default": "abs_diff",
          "title": "Kind",
          "type": "string"
        },
        "param": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Param",
          "type": "string"
        },
        "seconds_per_unit": {
          "minimum": 0,
          "title": "Seconds Per Unit",
          "type": "number"
        }
      },
      "required": [
        "param",
        "seconds_per_unit"
      ],
      "title": "AbsDiffTerm",
      "type": "object"
    },
    "BatchCapacity": {
      "additionalProperties": false,
      "description": "Batch limit of a machine, in a named unit (scheduled from TF-003).",
      "properties": {
        "capacity": {
          "exclusiveMinimum": 0,
          "title": "Capacity",
          "type": "number"
        },
        "unit": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "capacity",
        "unit"
      ],
      "title": "BatchCapacity",
      "type": "object"
    },
    "Calendar": {
      "additionalProperties": false,
      "description": "Explicit working intervals `[start, end)`, sorted and non-overlapping (D-065).\n\n`overtime` marks priced parts of that working time (D-125). It is a subset of\n`intervals`, so the verifier and solvers keep one working-time rule; only the cost\nobjective reads it. Entries are sorted, disjoint (touching allowed) and each lies inside\none merged working span.",
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "intervals": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 1000000,
          "title": "Intervals",
          "type": "array"
        },
        "overtime": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OvertimeInterval"
          },
          "maxItems": 1000000,
          "title": "Overtime",
          "type": "array"
        }
      },
      "required": [
        "id",
        "intervals"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "EpsilonBound": {
      "additionalProperties": false,
      "description": "Upper bound on a secondary objective.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ObjectiveKind"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "upper"
      ],
      "title": "EpsilonBound",
      "type": "object"
    },
    "EpsilonConstraint": {
      "additionalProperties": false,
      "description": "Optimize `primary` subject to upper bounds on other objectives.",
      "properties": {
        "bounds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EpsilonBound"
          },
          "title": "Bounds",
          "type": "array"
        },
        "mode": {
          "const": "epsilon_constraint",
          "default": "epsilon_constraint",
          "title": "Mode",
          "type": "string"
        },
        "primary": {
          "$ref": "#/$defs/ObjectiveKind"
        }
      },
      "required": [
        "primary"
      ],
      "title": "EpsilonConstraint",
      "type": "object"
    },
    "ExcludeMachineOverride": {
      "additionalProperties": false,
      "description": "Hard: remove the machine option; soft: add `penalty` to it (D-066).",
      "properties": {
        "fact_ref": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Fact Ref",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "kind": {
          "const": "exclude_machine",
          "default": "exclude_machine",
          "title": "Kind",
          "type": "string"
        },
        "machine_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Machine Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "penalty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Penalty"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fact_ref",
        "reason",
        "hardness",
        "machine_id"
      ],
      "title": "ExcludeMachineOverride",
      "type": "object"
    },
    "ExpediteOverride": {
      "additionalProperties": false,
      "description": "Raise a job to weight class 4 and optionally pull its due date in (D-066).",
      "properties": {
        "due": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "fact_ref": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Fact Ref",
          "type": "string"
        },
        "hardness": {
          "const": "hard",
          "title": "Hardness",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "job_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "const": "expedite",
          "default": "expedite",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fact_ref",
        "reason",
        "hardness",
        "job_id"
      ],
      "title": "ExpediteOverride",
      "type": "object"
    },
    "FamilyMatrixEntry": {
      "additionalProperties": false,
      "description": "Changeover seconds from one setup family to another (D-064).",
      "properties": {
        "from_family": {
          "maxLength": 200,
          "minLength": 1,
          "title": "From Family",
          "type": "string"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "to_family": {
          "maxLength": 200,
          "minLength": 1,
          "title": "To Family",
          "type": "string"
        }
      },
      "required": [
        "from_family",
        "to_family",
        "seconds"
      ],
      "title": "FamilyMatrixEntry",
      "type": "object"
    },
    "FrozenZone": {
      "additionalProperties": false,
      "description": "Operations of the previous plan starting before `until` keep their place (D-066).",
      "properties": {
        "tolerance": {
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "until": {
          "title": "Until",
          "type": "number"
        }
      },
      "required": [
        "until",
        "tolerance"
      ],
      "title": "FrozenZone",
      "type": "object"
    },
    "HoldOverride": {
      "additionalProperties": false,
      "description": "Delay a job until a time, or remove it from this solve when `until` is None (D-066).",
      "properties": {
        "fact_ref": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Fact Ref",
          "type": "string"
        },
        "hardness": {
          "const": "hard",
          "title": "Hardness",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "job_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "const": "hold",
          "default": "hold",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "required": [
        "id",
        "fact_ref",
        "reason",
        "hardness",
        "job_id"
      ],
      "title": "HoldOverride",
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "description": "A customer order made of operations; its effective weight comes from its class.",
      "properties": {
        "customer": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Customer"
        },
        "due": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "maxItems": 100000,
          "title": "Operations",
          "type": "array"
        },
        "promised_ship": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promised Ship"
        },
        "release": {
          "default": 0.0,
          "title": "Release",
          "type": "number"
        },
        "sales_order_refs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Sales Order Refs",
          "type": "array"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "held",
            "done"
          ],
          "title": "Status",
          "type": "string"
        },
        "weight_class": {
          "default": 1,
          "enum": [
            1,
            2,
            4
          ],
          "title": "Weight Class",
          "type": "integer"
        },
        "weight_override": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Override"
        }
      },
      "required": [
        "id",
        "operations"
      ],
      "title": "Job",
      "type": "object"
    },
    "Lexicographic": {
      "additionalProperties": false,
      "description": "Optimize objectives in strict priority order.",
      "properties": {
        "levels": {
          "items": {
            "$ref": "#/$defs/LexicographicLevel"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "mode": {
          "const": "lexicographic",
          "default": "lexicographic",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "levels"
      ],
      "title": "Lexicographic",
      "type": "object"
    },
    "LexicographicLevel": {
      "additionalProperties": false,
      "description": "One priority level; later levels may not worsen this one by more than the tolerance.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ObjectiveKind"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "tolerance_kind": {
          "default": "absolute",
          "enum": [
            "absolute",
            "relative"
          ],
          "title": "Tolerance Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LexicographicLevel",
      "type": "object"
    },
    "LockOverride": {
      "additionalProperties": false,
