        "available_from": {
          "default": 0.0,
          "title": "Available From",
          "type": "number"
        },
        "last_setup_family": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Setup Family"
        },
        "last_setup_params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "maxLength": 2000,
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Last Setup Params",
          "type": "object"
        }
      },
      "title": "MachineState",
      "type": "object"
    },
    "MismatchTerm": {
      "additionalProperties": false,
      "description": "Setup term: `seconds` when a setup parameter differs, else 0 (D-064).",
      "properties": {
        "kind": {
          "const": "mismatch",
          "default": "mismatch",
          "title": "Kind",
          "type": "string"
        },
        "param": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Param",
          "type": "string"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "param",
        "seconds"
      ],
      "title": "MismatchTerm",
      "type": "object"
    },
    "ObjectiveKind": {
      "description": "The thirteen schedule objectives (REQ-068); formulas live in objectives.py.",
      "enum": [
        "makespan",
        "weighted_completion",
        "max_lateness",
        "tardy_count",
        "weighted_tardy_count",
        "total_tardiness",
        "weighted_tardiness",
        "earliness_tardiness",
        "total_setup",
        "cost",
        "churn",
        "robustness",
        "soft_penalty"
      ],
      "title": "ObjectiveKind",
      "type": "string"
    },
    "Operation": {
      "additionalProperties": false,
      "description": "One processing step of a whole lot of `quantity` units, never split into pieces (D-061).\n\nSetup is the first phase of the operation, not a separate task (D-063): the machine is\nbusy on `[start, end)` and `setup_detached` chooses whether material must be present\nfrom `start` (false) or only from `setup_end` (true). `shift_crossing` says whether\nthe operation must fit inside one working interval or may pause over breaks (D-065).",
      "properties": {
        "batch_family": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Family"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "operator_needs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperatorNeed"
          },
          "title": "Operator Needs",
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ProcessingOption"
          },
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "pin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "predecessors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Precedence"
          },
          "title": "Predecessors",
          "type": "array"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "ready_time": {
          "default": 0.0,
          "title": "Ready Time",
          "type": "number"
        },
        "setup_detached": {
          "default": false,
          "title": "Setup Detached",
          "type": "boolean"
        },
        "setup_family": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Family"
        },
        "setup_params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "maxLength": 2000,
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Setup Params",
          "type": "object"
        },
        "shift_crossing": {
          "default": "forbid",
          "enum": [
            "forbid",
            "pause"
          ],
          "title": "Shift Crossing",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OperationStatus",
          "default": {
            "machine_id": null,
            "remaining_seconds": null,
            "state": "pending"
          }
        },
        "work_center_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Work Center Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "work_center_id",
        "quantity",
        "options"
      ],
      "title": "Operation",
      "type": "object"
    },
    "OperationStatus": {
      "additionalProperties": false,
      "description": "Shop-floor state: in-progress operations are placed at `now`; done ones are skipped.",
      "properties": {
        "machine_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "remaining_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Seconds"
        },
        "state": {
          "default": "pending",
          "enum": [
            "pending",
            "in_progress",
            "done"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "title": "OperationStatus",
      "type": "object"
    },
    "OperatorNeed": {
