      "properties": {
        "fact_ref": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Fact Ref",
          "type": "string"
        },
        "hardness": {
          "const": "hard",
          "title": "Hardness",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "lock",
          "default": "lock",
          "title": "Kind",
          "type": "string"
        },
        "machine_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "operation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "id",
        "fact_ref",
        "reason",
        "hardness",
        "operation_id"
      ],
      "title": "LockOverride",
      "type": "object"
    },
    "Machine": {
      "additionalProperties": false,
      "description": "A unary machine: one operation at a time; more capacity is more machines (D-062).\n\n`calendar_id` None means always working (D-065).",
      "properties": {
        "batch": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchCapacity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calendar_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calendar Id"
        },
        "hour_cost": {
          "default": 0.0,
          "minimum": 0,
          "title": "Hour Cost",
          "type": "number"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "restart": {
          "anyOf": [
            {
              "$ref": "#/$defs/RestartRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "setup_function_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Function Id"
        },
        "setup_hour_cost": {
          "default": 0.0,
          "minimum": 0,
          "title": "Setup Hour Cost",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/MachineState",
          "default": {
            "available_from": 0.0,
            "last_setup_family": null,
            "last_setup_params": {}
          }
        },
        "work_center_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Work Center Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "work_center_id"
      ],
      "title": "Machine",
      "type": "object"
    },
    "MachineState": {
      "additionalProperties": false,
      "description": "What the machine is doing at `now`: when it frees up and how it is set up.",
